# Copy this file to .env, then paste your Gemini API key after GEMINI_API_KEY=
# Easiest way on Windows: double-click SET_GEMINI_KEY.bat (it saves the key here and tests it).
# Get a free key at https://aistudio.google.com/apikey  ->  "Create API key"
#   (if you see "quota exhausted", choose "Create API key in NEW project")
# Keep the key only in .env. Never put it in browser JavaScript, a chat, or GitHub.
GEMINI_API_KEY=PASTE_YOUR_NEW_GEMINI_API_KEY_HERE

# Main model, then backups. If a model is out of quota (429), missing (404) or busy (503),
# the next one is used automatically. Separate multiple backups with commas.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-2.5-flash

PORT=5000
FLASK_DEBUG=0

# Government schemes auto-update (needs GEMINI_API_KEY and Google Search grounding)
SCHEMES_AUTO_UPDATE=1
SCHEMES_REFRESH_DAYS=7
# Optional: lets you trigger an update manually via POST /api/schemes/refresh (header X-Admin-Token)
ADMIN_TOKEN=

# Live mandi prices (Agmarknet, Govt. of India). Free key: register at https://data.gov.in -> My Account -> API key
DATA_GOV_API_KEY=
